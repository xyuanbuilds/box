.wrapper-5 {
  background-color: rgb(218, 230, 253);
  line-height: 1.5;
  margin-top: 12rpx;
  margin-right: 4rpx;
  padding: 0rpx 32rpx 0rpx 28rpx;
  box-sizing: border-box;
}

.site-container {
  border-radius: 12rpx;
  background-color: rgb(236, 243, 254);
  display: flex;
  flex-direction: column;
  padding: 20rpx 20rpx 4rpx 20rpx;
  box-sizing: border-box;
}

.header-section {
  margin-left: 4rpx;
  margin-right: 4rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.title-wrapper {
  margin-left: 4rpx;
  margin-right: 4rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
}

.site-title {
  color: rgb(39, 60, 97);
  font-size: 24rpx;
  font-weight: bold;
  white-space: nowrap;
  box-sizing: border-box;
}

.action-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  box-sizing: border-box;
}

.thumbnail-image {
  border-radius: 6rpx;
  flex-shrink: 0;
  width: 24rpx;
  height: 24rpx;
  box-sizing: border-box;
}

.action-text {
  color: rgb(92, 116, 157);
  font-size: 24rpx;
  margin-left: 8rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.content-section {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.info-wrapper {
  border-radius: 16rpx;
  background-color: rgb(255, 255, 255);
  border-color: #e2ecfd;
  border-style: solid;
  border-width: 2rpx;
  padding: 20rpx 20rpx 20rpx 24rpx;
  box-sizing: border-box;
}

.media-row {
  margin-right: 4rpx;
  margin-bottom: 4rpx;
  position: relative;
  width: 492rpx;
  height: 20rpx;
  box-sizing: border-box;
}

.image-gallery {
  position: absolute;
  left: 0rpx;
  right: 0rpx;
  top: 4rpx;
  bottom: 4rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
}

.gallery-image-one {
  border-radius: 6rpx;
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  box-sizing: border-box;
}

.gallery-image-two {
  border-radius: 4rpx;
  flex-shrink: 0;
  width: 12rpx;
  height: 16rpx;
  box-sizing: border-box;
}

.site-description {
  color: rgb(44, 65, 101);
  font-size: 24rpx;
  position: absolute;
  left: 24rpx;
  top: 0rpx;
  bottom: 0rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.additional-info {
  border-radius: 14rpx;
  background-color: rgb(255, 255, 255);
  border-color: #e2ecfd;
  border-style: solid;
  border-width: 2rpx;
  margin-top: 12rpx;
  padding: 20rpx 20rpx 20rpx 24rpx;
  box-sizing: border-box;
}

.description-wrapper {
  margin-top: 4rpx;
  margin-right: 4rpx;
  margin-bottom: 4rpx;
  position: relative;
  width: 492rpx;
  height: 20rpx;
  box-sizing: border-box;
}

.footer-section {
  background-color: rgb(255, 255, 255);
  height: 10rpx;
  margin-top: 12rpx;
  width: 536rpx;
  align-self: center;
  box-sizing: border-box;
}